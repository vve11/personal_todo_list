# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required on Render. Leave unset for local development.
# SECRET_KEY=
# SQLITE_PATH=/app/data/todos.db

# Neon connection for Vercel. Leave unset locally to keep using todos.db.
# Use the pooled string (hostname contains -pooler).
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Email reminders (SMTP) ---
# Example for QQ Mail:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your@qq.com
# SMTP_PASS=your-qq-authorization-code
# SMTP_FROM=your@qq.com
# SMTP_TLS=1

# Example for Gmail (use an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your@gmail.com
# SMTP_TLS=1

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# --- Reminder scheduler ---
# How often the server checks deadlines / reminder status (seconds)
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_SCHEDULER_ENABLED=1
REMINDER_WINDOW_MINUTES=30
REMINDER_MILESTONES=24h,6h,1h,overdue
